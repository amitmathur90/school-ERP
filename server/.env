# Copy this file to .env and fill in your PostgreSQL connection details.

# Option A: individual settings (simplest for a local Postgres install)
PGUSER=postgres
PGPASSWORD=Amit@28
PGHOST=localhost
PGPORT=5432
PGDATABASE=law_college_erp

# Option B: a single connection string instead (used automatically if set —
# this is the format hosted Postgres providers like Neon/Supabase/Railway
# give you). If DATABASE_URL is set, it overrides all the PG* settings above.
# DATABASE_URL=postgresql://user:password@host:5432/dbname
#
# SSL is auto-enabled whenever DATABASE_URL is set (hosted providers like
# Render/Heroku/Neon require it) and auto-disabled for a plain local
# install. Override with DB_SSL=true or DB_SSL=false if you need to force it.

PORT=4000

# Secret used to sign login sessions (JWT). MUST be set to a real random
# value before deploying anywhere real — the app will run with an insecure
# default and print a warning if you don't. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# The frontend's URL — PayU redirects the browser back here after payment.
# Change this if your frontend runs somewhere other than the Vite default.
FRONTEND_URL=http://localhost:5173

# Only ONE of Razorpay or PayU can be active at a time (chosen by the admin
# in-app, under Fees). You can fill in both here and switch between them
# without restarting .env each time — just flip the selector in the app.

# Razorpay (get free test keys at https://dashboard.razorpay.com/app/keys —
# toggle "Test Mode" first). Works out of the box on localhost: Razorpay's
# checkout is a JS popup, no public URL needed for testing.
RAZORPAY_KEY_ID=rzp_test_TDI5NKtOb3CFuS
RAZORPAY_KEY_SECRET=Q9MPPQkRQsofbmAuNxI3kRkH

# PayU (get free test credentials at https://onboarding.payu.in/signup — or
# use PayU's published test credentials, see README). IMPORTANT: PayU's
# flow needs your server to be reachable from the internet (PayU redirects
# the browser back to your server after payment) — plain localhost won't
# work for testing. Use a tunnel like ngrok, or test this after deploying
# somewhere public. Razorpay is the easier one to test purely on localhost.
PAYU_MERCHANT_KEY=
PAYU_SALT=
PAYU_BASE_URL=https://test.payu.in/_payment
