# Copy this file to .env and fill in real values. Never commit the real .env.

# --- Local PostgreSQL (used if DATABASE_URL below is not set) ---
PGUSER=postgres
PGPASSWORD=postgres
PGHOST=localhost
PGPORT=5432
PGDATABASE=school_erp

# --- OR a hosted Postgres connection string (Neon/Supabase/Railway/Render) ---
# Takes priority over the PG* variables above if set.
# DATABASE_URL=postgresql://user:password@host/dbname

# Random string used to sign login session tokens. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-this-to-a-random-string

PORT=4000
FRONTEND_URL=http://localhost:5173

# --- Online payment gateways (configure one) ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

PAYU_MERCHANT_KEY=
PAYU_SALT=
PAYU_BASE_URL=https://test.payu.in/_payment
